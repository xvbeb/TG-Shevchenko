APP_NAME="ADHD Reader API"
ENVIRONMENT=local
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/adhd_reader"
DATABASE_PUBLIC_URL=
DB_AUTO_CREATE=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_URL="https://reader.localhost"
ALLOW_DEV_AUTH=true
MAX_UPLOAD_MB=20
DEFAULT_CHUNK_WORDS=220
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
WELCOME_BONUS_PROMPT_VERSION=v1
WELCOME_BONUS_CONTEXT_CHUNKS=10
WELCOME_BONUS_MAX_CONTEXT_CHARS=12000
